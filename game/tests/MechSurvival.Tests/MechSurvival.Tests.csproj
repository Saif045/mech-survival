    <Compile Include="../../mech/MechBody.cs" Link="Model/MechBody.cs" />
    <Compile Include="../../mech/MechBodyView.cs" Link="Model/MechBodyView.cs" />
    <Compile Include="../../mech/gas/MechGasSnapshot.cs" Link="Model/MechGasSnapshot.cs" />
