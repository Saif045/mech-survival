# Godot 4+ specific ignores
.godot/
/android/
.vscode/
steam_appid.txt
build
/factory/artifacts/*
!/factory/artifacts/.gdignore
/factory/tools/ab_test/.runtime/
/factory/tools/ab_test/vm-endpoint.local.psd1
/.tmp-*/
/addons/godotsteam/win64/~*.TMP
/addons/godotsteam/win64/~*.dll
/Modelfile.hermes3-68k
/ollama-agent-tests.ps1
/addons/GodotGAS/**/*.import

# .NET build output
bin/
obj/

# Godot generates UID metadata for C# files it scans. Test-only source is not a Godot script surface.
/factory/tests/GameFactory.Tests/**/*.cs.uid
# Aider runtime state. Project configuration and .aiderignore are tracked.
/.aider*
!/.aider.conf.yml
!/.aider.model.settings.yml
!/.aiderignore

/game/artifacts/*
!/game/artifacts/.gdignore
/game/tests/**/*.cs.uid
